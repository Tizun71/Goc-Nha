# Copy this file to .env and adjust values as needed.

# MCP server (packages/mcp-server/src/server.ts): URL of the running Vite dev app.
# It connects to the WebSocket hub at <DMR_APP_URL>/__dmr.
# Must match the dev server port in apps/web/vite.config.ts (5173, strictPort).
DMR_APP_URL=http://localhost:5173
