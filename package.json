{
  "name": "goc-nha",
  "private": true,
  "version": "0.1.0",
  "description": "Plan your room before you buy furniture: a 2D and isometric 3D room planner with real-size furniture, daylight simulation and an MCP server for Claude.",
  "license": "AGPL-3.0-or-later",
  "author": "Tizun71",
  "homepage": "https://github.com/Tizun71/Goc-Nha#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tizun71/Goc-Nha.git"
  },
  "bugs": {
    "url": "https://github.com/Tizun71/Goc-Nha/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "pnpm --filter @goc-nha/web dev",
    "build": "tsc -b && pnpm --filter @goc-nha/web build",
    "preview": "pnpm --filter @goc-nha/web preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "mcp": "pnpm --filter @goc-nha/mcp-server start"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
